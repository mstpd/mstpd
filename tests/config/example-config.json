{
  "bridges": {
    "br-test": {
      "force-protocol-version": "mstp",
      "bridge-priority": 4,
      "bridge-max-age": 24,
      "bridge-forward-delay": 18,
      "hello-time": 2,
      "tx-hold-count": 4,
      "ageing-time": 600,
      "mstp": {
        "max-hops": 30,
        "mst-config-id": {
          "configuration-name": "mstpd-example",
          "revision-level": 1
        },
        "vid2fid": [
          { "fid": 1, "vids": ["1-10"] },
          { "fid": 2, "vids": ["20-29", "100"] }
        ],
        "fid2mstid": [
          { "mstid": 1, "fids": ["1"] },
          { "mstid": 2, "fids": ["2"] }
        ],
        "msti": {
          "1": { "bridge-priority": 7 },
          "2": { "bridge-priority": 9 }
        }
      },
      "ports": {
        "br-testp1": {
          "port-priority": 4,
          "admin-external-cost": 40000,
          "admin-point-to-point": "yes",
          "auto-edge-port": false,
          "network-port": true,
          "mstp": {
            "cist-admin-internal-cost": 30000,
            "msti": {
              "1": {
                "port-priority": 6,
                "admin-internal-cost": 50000
              },
              "2": {
                "port-priority": 10,
                "admin-internal-cost": 60000
              }
            }
          }
        },
        "br-testp2": {
          "restricted-role": true,
          "restricted-TCN": true,
          "dont-txmt": true
        },
        "br-testp3": {
          "admin-point-to-point": "no",
          "admin-edge-port": true,
          "bpdu-guard-port": true
        },
        "br-testp4": {
          "admin-edge-port": true,
          "bpdu-filter-port": true
        }
      }
    }
  }
}
